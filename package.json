{
  "name": "un-pe-web",
  "private": true,
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild": "cn build --content \"src/**/*.{ts,tsx}\" -o src/lib/cn-tables.ts",
    "pretypecheck": "cn build --content \"src/**/*.{ts,tsx}\" -o src/lib/cn-tables.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "sharp": "^0.35.4",
    "typescript": "~6",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
